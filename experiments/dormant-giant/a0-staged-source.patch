+    def init_staged_bank_caches(
+        self,
+        layouts: dict[str, tuple[tuple[int, ...], torch.dtype]],
+    ) -> None:
+        """Allocate BF16 GPU slot caches without persistent full host expert banks.
+
+        Dormant Giant A0 owns the cold source and supplies compact pinned rows only
+        after FreeToken has authored the pending copy slots. This P0 seam is
+        deliberately narrow: GPU offload only, no prefill overlap, no CUDA-graph
+        capture, and BF16 only.
+        """
+        assert self.decode_target == "gpu", "staged A0 is GPU offload only"
+        assert self.quant_format == "bf16", "staged A0 is BF16 only"
+        assert not self.prefill_overlap, "staged A0 does not implement prefill overlap"
+        assert not self.bank_sources and not self.banks, "host banks are already registered"
+        assert set(layouts) == set(self.bank_schema), (
+            f"layouts {sorted(layouts)} do not match schema {self.bank_schema}"
+        )
+
+        self.bank_caches = {}
+        for name in self.bank_schema:
+            row_shape, dtype = layouts[name]
+            row_shape = tuple(int(dim) for dim in row_shape)
+            assert row_shape and all(dim > 0 for dim in row_shape), (name, row_shape)
+            self.bank_caches[name] = torch.empty(
+                (self.cache_size, *row_shape), dtype=dtype, device=self.device
+            )
+
+        self.banks = [([], self.bank_caches[name]) for name in self.bank_schema]
+        self.layer_residency = []
+        self._copy_fused_ok = False
+        self._copy_dst_ptrs = None
+        self._copy_src_ptrs = None
+        self._copy_feat_bytes = None
+        self._staged_source_mode = True
+
+    def set_staged_copy_callback(self, callback) -> None:
+        """Install the synchronous graph-disabled A0 source hook used by copy_missing."""
+        assert self.decode_target == "gpu", "staged A0 is GPU offload only"
+        assert self.quant_format == "bf16", "staged A0 is BF16 only"
+        assert not self.prefill_overlap, "staged A0 does not implement prefill overlap"
+        assert getattr(self, "_staged_source_mode", False), (
+            "init_staged_bank_caches must run before installing staged A0 callback"
+        )
+        assert not self.bank_sources, "staged A0 forbids persistent full host banks"
+        if not callable(callback):
+            raise TypeError("staged copy callback must be callable")
+        self._staged_copy_callback = callback
+
     def _init_prefill_overlap_buffers(self) -> None:
