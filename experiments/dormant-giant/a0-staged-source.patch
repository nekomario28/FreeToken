+    def copy_missing_bank_from_compact(
+        self,
+        bank_name: str,
+        compact_source: torch.Tensor,
+        *,
+        start: int,
+        count: int,
+    ) -> None:
+        """Synchronously copy one staged-source bank microbatch into owned slots.
+
+        ``start``/``count`` select the exact ``evict_slots`` slice authored by the
+        immediately preceding ``ensure_experts`` or ``materialize_layer``. Compact
+        source rows are local 0..count-1. ``num_indices=None`` makes the existing
+        kernel use the sliced index length instead of the total pending-copy count.
+        """
+        assert self.decode_target == "gpu", "staged A0 is GPU offload only"
+        assert self.quant_format == "bf16", "staged A0 is BF16 only"
+        assert self.device.type == "cuda", "staged A0 requires CUDA"
+        assert not self.prefill_overlap, "staged A0 does not implement prefill overlap"
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("staged A0 is graph-disabled; CUDA capture is unsupported")
+        assert isinstance(start, int) and not isinstance(start, bool) and start >= 0
+        assert isinstance(count, int) and not isinstance(count, bool) and count >= 0
+        authoritative_count = int(self.num_indices.item())
+        assert start + count <= authoritative_count, (
+            start,
+            count,
+            authoritative_count,
+        )
+        if bank_name not in self.bank_caches:
+            raise KeyError(f"unknown staged bank {bank_name!r}")
+        if count == 0:
+            return
+
+        cache = self.bank_caches[bank_name]
+        src = compact_source
+        assert src.device.type == "cpu" and src.is_pinned(), (
+            f"compact bank {bank_name!r} must be pinned CPU memory"
+        )
+        assert src.is_contiguous(), f"compact bank {bank_name!r} must be contiguous"
+        assert src.size(0) == count, (bank_name, src.shape, count)
+        assert src.shape[1:] == cache.shape[1:], (bank_name, src.shape, cache.shape)
+        assert src.dtype == cache.dtype, (bank_name, src.dtype, cache.dtype)
+
+        dst_indices = self.evict_slots[start : start + count]
+        compact_src_indices = torch.arange(
+            count, dtype=dst_indices.dtype, device=self.device
+        )
+        from freetoken.kernel import fast_index_copy_jit
+
+        fast_index_copy_jit(cache, dst_indices, src, compact_src_indices, None)
+        # P0 releases the compact source/lease immediately after this call. Keep
+        # the first physical seam synchronous so GPU host-memory reads are complete.
+        torch.cuda.current_stream(self.device).synchronize()
+
     def copy_missing(self) -> None:
         assert self.banks, "set_bank_sources must register the banks first"
